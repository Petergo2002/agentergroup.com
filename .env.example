NEXT_PUBLIC_SUPABASE_URL=https://rklntfzmqayziqesjoih.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy fallback only. Prefer SUPABASE_SECRET_KEY for new deployments.
SUPABASE_SERVICE_ROLE_KEY=service_role_replace_me
OPENROUTER_API_KEY=sk-or-v1-replace_me
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_REQUIRE_ZDR=true
FIRECRAWL_API_KEY=fc_replace_me
RESEND_API_KEY=re_replace_me
# Verify avenro.se in Resend before sending; configure Supabase SMTP separately.
EMAIL_FROM_ADDRESS="Avenro <noreply@avenro.se>"
# Where replies land. Lead notifications override this with the lead's own address.
EMAIL_REPLY_TO_ADDRESS=info@avenro.se
# Absolute origin the email logo and links point at. Defaults to NEXT_PUBLIC_APP_URL,
# falling back to https://avenro.se on localhost so dev test sends still show the logo.
EMAIL_ASSET_BASE_URL=https://avenro.se
# Postal address rendered in the email footer. Required by CAN-SPAM for anything promotional.
EMAIL_POSTAL_ADDRESS=""
COMPOSIO_API_KEY=cmp_replace_me
COMPOSIO_WEBHOOK_SECRET=whsec_replace_me
COMPOSIO_TOOLKIT_VERSION_GMAIL=20260323_00
COMPOSIO_TOOLKIT_VERSION_GOOGLECALENDAR=20260309_00
COMPOSIO_TOOLKIT_VERSION_CAL=latest
COMPOSIO_TOOLKIT_VERSION_GOOGLEDRIVE=20260309_00
COMPOSIO_TOOLKIT_VERSION_OUTLOOK="latest"
COMPOSIO_TOOLKIT_VERSION_SLACK=20260511_01
COMPOSIO_TOOLKIT_VERSION_HUBSPOT=20260501_00
COMPOSIO_TOOLKIT_VERSION_SHOPIFY=20260506_00
COMPOSIO_TOOLKIT_VERSION_GOOGLEADS=20260506_00
COMPOSIO_TOOLKIT_VERSION_TEXT_TO_PDF=latest
# Optional Gmail auth-config override. Leave empty to use Composio-managed Gmail auth.
# For custom Google OAuth, create the auth config in Composio and set its id here.
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
# Shopify does not support Composio-managed auth. Either provide a pre-created
# Shopify auth config ID, or provide OAuth credentials so the app can create one.
COMPOSIO_SHOPIFY_AUTH_CONFIG_ID=
COMPOSIO_SHOPIFY_CLIENT_ID=
COMPOSIO_SHOPIFY_CLIENT_SECRET=
COMPOSIO_SHOPIFY_OAUTH_REDIRECT_URI=https://backend.composio.dev/api/v3.1/toolkits/auth/callback
COMPOSIO_SHOPIFY_SCOPES=
# Local development. Vercel Production: https://avenro.se
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel Production: https://widget.avenro.se (separate apps/widget-v2 project)
NEXT_PUBLIC_WIDGET_APP_URL=http://localhost:5173
# Managed-plan mode is the safe default. Set to true only when self-service Stripe billing is intentionally enabled.
NEXT_PUBLIC_SELF_SERVE_BILLING_ENABLED=false
# PDF/text uploads in the widget. Off by default: a document only reaches the
# model as a URL, so answering from it depends on a knowledge-indexing pass the
# upload route does not await — a visitor can upload and ask before any of it is
# searchable. Image uploads are unaffected and always work.
WIDGET_DOCUMENT_UPLOAD_ENABLED=false
# Legacy fallback; remove in production or set to https://widget.avenro.se.
WIDGET_APP_URL=http://localhost:5173
WIDGET_ACCESS_SECRET=widget_access_replace_me
WIDGET_PREVIEW_SECRET=widget_preview_replace_me
RATE_LIMIT_SECRET=rate_limit_replace_me
# Optional dedicated HMAC secret for short-lived signup consent tokens.
# Falls back to RATE_LIMIT_SECRET (or its existing server-side fallback) when empty.
LEGAL_CONSENT_SECRET=legal_consent_replace_me
GDPR_RETENTION_CRON_SECRET=gdpr_retention_replace_me

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_replace_me
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_replace_me
STRIPE_EXTRA_CREDITS_500_PRICE_ID=price_replace_me
# Set false to immediately restore the classic Agents + Widgets experience.
NEXT_PUBLIC_MILO_EXPERIENCE_ENABLED=true

# Error reporting (Sentry). Every variable here is optional: with no DSN the app
# builds and runs identically and reports nothing. See docs/runbooks/observability.md.
# Server and edge runtimes. EU-region projects use an ingest.de.sentry.io host.
SENTRY_DSN=
# Browser runtime. Same value as SENTRY_DSN — a DSN is a public key by design and
# ships inside the client bundle.
NEXT_PUBLIC_SENTRY_DSN=
# Tracing is opt-in and off by default so it cannot quietly become a per-request cost.
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Build-time sourcemap upload only. Scope the token to org:ci and nothing more,
# and set it in the hosting/CI environment rather than a shared local .env.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
